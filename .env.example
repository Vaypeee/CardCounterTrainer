# Copy to .env.development.local (local Supabase stack, used by `bun run dev`)
# and/or .env.production.local (hosted project, used by `bun run build`).
# Do not use a plain .env.local: the scripts read the per-mode files only.
# Leave everything empty to run the trainer offline (no accounts, no duel).

# Supabase project URL and anon/publishable key (both are public, browser-side values)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Google OAuth client ID for the Google Identity Services sign-in button
VITE_GOOGLE_CLIENT_ID=
