# =========================================================
# Card Counting Trainer (Velua) - what never goes to GitHub
# Rule of thumb: secrets, local state, generated files and the
# private "owner analytics" feature stay on this machine.
# =========================================================

# ---------- Secrets & environment ----------
# Supabase URL/keys (local + hosted), Google client id, any future key
.env
.env.*
!.env.example
*.env
.env.keys
.dev.vars
.dev.vars.*
# Edge Function secrets (TRACK_SECRET, ...)
supabase/functions/.env
supabase/functions/.env.*
# Keys and certificates of any kind
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa*
*.secret
*.secrets
secrets/
credentials*.json
service-account*.json

# ---------- Supabase CLI local state ----------
# linked project ref, pooler URL, local runtime secrets
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.*
supabase/seed.local.sql
# Copy of src/core generated by `bun run sync-core` (do not version it twice)
supabase/functions/_shared/core/

# ---------- Cloudflare / Wrangler ----------
.wrangler/
wrangler.toml.local
.cloudflare/

# ---------- Private: owner analytics (sessions, IP, location) ----------
# Kept off GitHub on purpose: it is a bonus of the live site, not part of the trainer.
/functions/
supabase/functions/track-session/
supabase/migrations/*_session_tracking.sql
scripts/track-test.js
src/core/ua.js
tests/ua.test.js
src/private/

# ---------- Private: AI assistant notes & local tooling ----------
CLAUDE.md
CLAUDE.local.md
.claude/
.cursor/
.aider*
.copilot/

# ---------- Build output & dependencies ----------
node_modules/
dist/
dist-ssr/
*.local
.vite/
.cache/
coverage/
*.tsbuildinfo

# ---------- Logs & debug ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*
*.dump
*.sql.gz
*.backup

# ---------- Exports that may contain user data ----------
*.csv
*.xlsx
exports/
backups/

# ---------- OS & editors ----------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
*.code-workspace

# ---------- Other hosts (not used, but never leak their state) ----------
.vercel/
.netlify/
